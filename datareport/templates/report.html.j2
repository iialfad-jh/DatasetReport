<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.title }}</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.45; margin: 2rem auto; max-width: 1100px; padding: 0 1rem; color: #222; }
    h1 { margin-bottom: .25rem; }
    .summary { background: #f5f7fa; border: 1px solid #d9e0e7; padding: 1rem; margin: 1.5rem 0; }
    .overview { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: .75rem; margin: 1.5rem 0; }
    .metric { border: 1px solid #d9e0e7; padding: .75rem; }
    .metric strong { display: block; font-size: 1.4rem; }
    .file { border-top: 1px solid #d9e0e7; padding: 1.25rem 0; }
    .warning { color: #8a4b00; background: #fff8e6; border-color: #e9c46a; }
    .muted { color: #5f6b76; font-size: .9rem; }
    table { border-collapse: collapse; width: 100%; margin-top: .75rem; }
    th, td { border: 1px solid #d9e0e7; padding: .5rem; text-align: left; vertical-align: top; }
    th { background: #f5f7fa; }
    code { white-space: pre-wrap; word-break: break-word; }
    .flag { display: inline-block; background: #fff1d6; border: 1px solid #e9c46a; color: #754c00; margin: 0 .25rem .25rem 0; padding: .1rem .35rem; }
  </style>
</head>
<body>
  <h1>{{ report.title }}</h1>
  <section class="overview" aria-label="Dataset overview">
    <div class="metric">Files<strong>{{ report.files | length }}</strong></div>
    <div class="metric">Rows<strong>{{ report.total_rows }}</strong></div>
    <div class="metric">Columns<strong>{{ report.total_columns }}</strong></div>
    <div class="metric">Flagged columns<strong>{{ report.quality_column_count }}</strong></div>
    <div class="metric">Failed files<strong>{{ report.failed_files | length }}</strong></div>
  </section>

  <section class="summary">
    <h2>AI Summary</h2>
    <p>{{ report.ai_summary }}</p>
  </section>

  {% if report.files %}
    {% for file in report.files %}
      <section class="file">
        <h2>{{ file.file_name }}</h2>
        <p>Type: {{ file.file_type }} | Rows: {{ file.row_count }} | Columns: {{ file.column_count }} | Duplicate rows in analyzed data: {{ file.duplicate_row_count }} ({{ "%.2f" | format(file.duplicate_rate * 100) }}%)</p>
        {% if file.is_sampled %}<p class="muted">Detailed column statistics use the first {{ file.analyzed_row_count }} rows.</p>{% endif %}
        <table>
          <thead>
            <tr><th>Column</th><th>dtype</th><th>Missing count</th><th>Missing rate</th><th>Unique values</th><th>Quality flags</th><th>Numeric / text stats</th><th>Top values</th><th>Sample values</th></tr>
          </thead>
          <tbody>
          {% for column in file.columns %}
            <tr>
              <td>{{ column.name }}</td>
              <td>{{ column.dtype }}</td>
              <td>{{ column.missing_count }}</td>
              <td>{{ "%.2f" | format(column.missing_rate * 100) }}%</td>
              <td>{{ column.unique_count }} ({{ "%.2f" | format(column.unique_rate * 100) }}%)</td>
              <td>{% if column.quality_flags %}{% for flag in column.quality_flags %}<span class="flag">{{ flag }}</span>{% endfor %}{% else %}ok{% endif %}</td>
              <td>{% if column.mean is not none %}min={{ column.min_value }}, max={{ column.max_value }}, mean={{ "%.2f" | format(column.mean) }}, median={{ "%.2f" | format(column.median) }}, std={{ "%.2f" | format(column.std) }}{% elif column.mean_length is not none %}length {{ column.min_length }}-{{ column.max_length }}, avg {{ "%.2f" | format(column.mean_length) }}{% else %}-{% endif %}</td>
              <td>{% if column.top_values %}{% for item in column.top_values %}<code>{{ item.value }} ({{ item.count }})</code>{% if not loop.last %}, {% endif %}{% endfor %}{% else %}-{% endif %}</td>
              <td><code>{{ column.sample_values | join(", ") }}</code></td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </section>
    {% endfor %}
  {% else %}
    <p>No supported data files were found.</p>
  {% endif %}

  {% if report.failed_files %}
    <section class="summary warning">
      <h2>Files that could not be processed</h2>
      <ul>{% for failed in report.failed_files %}<li><strong>{{ failed.file_name }}</strong>: {{ failed.error }}</li>{% endfor %}</ul>
    </section>
  {% endif %}
</body>
</html>
